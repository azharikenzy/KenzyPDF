<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ضغط ملفات Kenzy PDF"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSelectFileToCompress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اختر ملف PDF للضغط"
        android:backgroundTint="#F59E0B"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnExecuteCompress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ضغط الملف وتقليل الحجم"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E293B"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvCompressStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختر ملف PDF كبيراً لبدء تقليص حجمه بجودة عالية..."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

</LinearLayout>
