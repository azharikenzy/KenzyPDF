<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="تحويل PDF إلى صور - Kenzy PDF"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnSelectPdfForImages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="اختر ملف PDF للتحويل إلى صور"
        android:backgroundTint="#EC4899"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnExecutePdfToImages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="استخراج وتحويل الصفحات إلى صور"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#1E293B"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvPdfToImagesStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اختر ملف PDF لاستخراج صفحاته كصور عالية الجودة..."
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>
    </ScrollView>

</LinearLayout>
